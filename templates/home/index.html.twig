        document.querySelectorAll('.map-actions [data-action]').forEach(function(button){button.addEventListener('click',function(){var action=button.dataset.action;try{if(action==='zoom-in')map.zoomIn();else if(action==='zoom-out')map.zoomOut();else if(action==='search'){var input=document.getElementById('territory-search');input.focus();input.scrollIntoView({block:'nearest'});}else if(action==='print'){map.invalidateSize();window.print();}else if(action==='excel'||action==='word')downloadReport(action);else if(action==='fullscreen'){var section=document.querySelector('.map-section');if(!document.fullscreenElement&&section.requestFullscreen)section.requestFullscreen();else if(document.exitFullscreen)document.exitFullscreen();}else if(action==='labels'){document.querySelector('.map-section').classList.toggle('hide-department-labels');button.classList.toggle('active');showNotice(button.classList.contains('active')?'Libellés des départements masqués.':'Libellés des départements affichés.');}}catch(error){showNotice('Action indisponible dans ce navigateur.');}});});
        var workspace=document.querySelector('.workspace');function setSidebarOpen(open){workspace.classList.toggle('sidebar-collapsed',!open);window.setTimeout(function(){map.invalidateSize();},280);}document.getElementById('sidebar-toggle').addEventListener('click',function(){setSidebarOpen(false);});document.getElementById('sidebar-reopen').addEventListener('click',function(){setSidebarOpen(true);});
        document.querySelectorAll('.indicator-item').forEach(function(item) { item.addEventListener('click',function(){document.querySelectorAll('.indicator-item.selected').forEach(function(el){el.classList.remove('selected');});item.classList.add('selected');selectedMetric=item.dataset.metric||'population';selectedRegion=null;selectedDepartment=null;selectedCommune=null;document.getElementById('view-panel').hidden=true;document.getElementById('view-status').textContent='Valeur par r\u00e9gion - d\u00e9monstration';renderDetails('Vue nationale','Environ 32 millions d\u2019habitants','S\u00e9lectionnez une r\u00e9gion pour consulter ses indicateurs.',[],'');window.setTimeout(function(){map.invalidateSize();if(nigerLayer)map.fitBounds(nigerLayer.getBounds(),{padding:[30,30],maxZoom:7});updateMarkers();},80);});});
        document.querySelectorAll('[data-map-mode]').forEach(function(button){button.addEventListener('click',function(){mapDisplayMode=button.dataset.mapMode;document.querySelectorAll('[data-map-mode]').forEach(function(other){other.classList.toggle('active',other===button);});updateMarkers();});});
        document.getElementById('value-mode').addEventListener('change',function(){displayMode=this.value;updateMarkers();if(selectedRegion){renderDetails(selectedCommune?'Commune de '+selectedCommune:selectedDepartment?'Département de '+selectedDepartment:'Région de '+selectedRegion,selectedRegion,'Indicateurs estimés pour le territoire sélectionné.',[],'');}});
        document.getElementById('export-selection').addEventListener('click',function(){downloadReport('excel');});
        document.querySelectorAll('.nav-tab').forEach(function(tab){tab.addEventListener('click',function(){
            document.querySelectorAll('.nav-tab').forEach(function(x){x.classList.remove('active');});
            tab.classList.add('active'); showView(tab.dataset.view);
        });});
        fetch({{ path('api_rgph_indicators')|json_encode|raw }}).then(function(response){if(!response.ok)throw new Error('API unavailable');return response.json();}).then(function(payload){
            if(payload.regions){window.rgphStats=payload.regions;updateMarkers();}
        }).catch(function(){ /* les données de démonstration locales restent affichées */ });
        fetch({{ path('api_rgph_territorial_indicators')|json_encode|raw }}).then(function(response){if(!response.ok)throw new Error('Territorial indicators unavailable');return response.json();}).then(function(payload){window.rgphAreaStats=payload.areas||[];}).catch(function(){window.rgphAreaStats=[];});
        document.addEventListener('fullscreenchange',function(){window.setTimeout(function(){map.invalidateSize();},100);});
        map.on('zoomend', function() {
            updateMarkers();
        });
        renderRegionList();
        updateMarkers();
        window.setTimeout(function(){var splash=document.getElementById('rgph-splash');if(splash){splash.classList.add('is-leaving');window.setTimeout(function(){splash.remove();},500);}},5500);
    </script>
{% endblock %}
