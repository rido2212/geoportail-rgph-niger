            var departments=findRegionCommunes(regionName), names=Object.keys(departments).filter(function(name){return normalizeName(regionName)==='niamey'||normalizeName(name)!=='arrondissementscommunaux';});
            var totalUnits=names.reduce(function(sum,name){return sum+Math.max(1,departments[name].length);},0)||1;
            var deptUnits=departmentName?Math.max(1,(findDepartmentCommunes(regionName,departmentName)||[]).length):totalUnits;
            var ratio=departmentName?(communeName?1/totalUnits:deptUnits/totalUnits):1;
            var result={}; Object.keys(base).forEach(function(key){result[key]=base[key];});
            ['population','households','establishments'].forEach(function(key){result[key]=Math.round(Number(base[key]||0)*ratio);});
            var seed=(normalizeName(departmentName||regionName).split('').reduce(function(a,c){return a+c.charCodeAt(0);},0)+(communeName?normalizeName(communeName).length*7:0))%9-4;
            ['healthRate','povertyRate','economicRate','literacyRate','languageShare','housingRate'].forEach(function(key){result[key]=Math.max(0,Math.min(100,Number(base[key]||0)+seed));});
            result._level=communeName?'commune':departmentName?'department':'region'; result._name=communeName||departmentName||regionName;
